# Copy to .env and adjust. .env is git-ignored and excluded from the image.
LLC2160_IMAGE=ghcr.io/aashishpanta0/nsdf-llc2160-dashboard:latest
LLC2160_PLATFORM=linux/amd64
# Host socket the dashboard is published on.
LLC2160_BIND_ADDRESS=127.0.0.1
LLC2160_PORT=11957
# Socket the Panel server listens on inside the container.
LLC2160_LISTEN_ADDRESS=0.0.0.0
LLC2160_CONTAINER_PORT=5006
# Allowed WebSocket origin(s); set to the public hostname in production.
LLC2160_ALLOW_WS_ORIGIN=*
# Dataset: JSON config, IDX path, or URL. Local files in ./data are mounted at /data,
# e.g. LLC2160_DATASET=/data/my-dataset/visus.idx
LLC2160_DATASET=json/nasa.json
